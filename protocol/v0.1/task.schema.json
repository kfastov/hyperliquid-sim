{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kfastov/hyperliquid-sim/protocol/v0.1/task.schema.json",
  "title": "GitHub Project Protocol strict task",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "issue", "objective", "scope", "inputs", "dependencies", "acceptance", "deliverables", "risks"],
  "properties": {
    "protocol": {"const": "gpp/0.1"},
    "issue": {"type": "integer", "minimum": 1},
    "objective": {"type": "string", "minLength": 1},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["write", "forbidden"],
      "properties": {
        "write": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "forbidden": {"type": "array", "items": {"type": "string"}}
      }
    },
    "inputs": {"type": "array", "items": {"type": "string"}},
    "dependencies": {"type": "array", "items": {"type": "integer", "minimum": 1}},
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commands", "assertions"],
      "properties": {
        "commands": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "assertions": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "deliverables": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "risks": {"type": "array", "items": {"type": "string"}},
    "notes": {"type": "string"}
  }
}
